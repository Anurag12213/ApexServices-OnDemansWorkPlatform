# ==========================================
# ApexServices Environment Configuration Template
# Duplicate this file to .env and adjust values for your environment
# ==========================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Credentials & Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apex_services
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT Token Signing Security (Use 256-bit Hex or Base64 secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Completion Verification OTP Security Secret
OTP_SECRET=ApexServicesAuthoritativeOtpSecretKey9876543210

# Google OAuth2 Authentication (From Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS Security (Comma-separated allowed client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://apexservices.com,https://www.apexservices.com

# Actuator Health & Metrics Exposure
ACTUATOR_EXPOSURE=health,info,metrics

# Seed User Default Passwords (Used only during initial database bootstrap)
ADMIN_DEFAULT_PASSWORD=admin123
PARTNER_DEFAULT_PASSWORD=partner123
CUSTOMER_DEFAULT_PASSWORD=customer123

# Frontend Portal URLs
CUSTOMER_PORTAL_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174
PARTNER_PORTAL_URL=http://localhost:5175

# ==========================================
# Email & Brevo Transactional Service
# ==========================================
BREVO_API_KEY=xkeysib-your_brevo_api_key_placeholder
MAIL_FROM_EMAIL=notifications@apexservices.com
MAIL_FROM_NAME=Apex Services
NOTIFICATION_EMAIL_PROVIDER=brevo

# Centralized Email OTP Security & Policy
EMAIL_OTP_HMAC_SECRET=c8f5e2d1a4b70938475610293847561029384756102938475610293847561029
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_WINDOW=5
