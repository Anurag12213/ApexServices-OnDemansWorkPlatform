# ==========================================
# ApexServices Root Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example

# Dependency directories
node_modules/
**/node_modules/

# Production & Build outputs
dist/
**/dist/
target/
**/target/
build/
**/build/
out/
**/out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo

# OS Generated files
.DS_Store
Thumbs.db
desktop.ini

# Maven Wrapper JAR (can be downloaded by mvnw)
.mvn/wrapper/maven-wrapper.jar
**/maven-wrapper.jar
