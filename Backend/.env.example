DB_SSL_MODE=PREFERRED
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslMode=${DB_SSL_MODE}&trustServerCertificate=true&serverTimezone=UTC

# JWT & OTP Security Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
OTP_SECRET=ApexServicesAuthoritativeOtpSecretKey9876543210

# Email & Brevo Transactional Service
